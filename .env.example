# Copy to .env on the server. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-cyber
PORT=3001
NODE_ENV=development
APP_ORIGINS=http://localhost:5173,https://localhost
# Public HTTPS URL of the deployed LOW API; required by native Android builds for remote services.
VITE_LOW_API_URL=
# Add the deployed web origin here as an exact comma-separated value when using a browser/PWA.\n